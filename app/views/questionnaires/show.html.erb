<%- content_for :title, @questionnaire.name -%>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <% if flash[:notice] %>
        <div class="alert alert-success" role="alert">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= flash[:alert] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%- if session[:user_id] -%>
        <%- unless flash[:notice] -%>
          <p>Вы уже прошли этот опрос.</p>
        <% end %>
      <%- else -%>
        <h1 class="mb-4"><%= @questionnaire.name %></h1>

        <%= form_with url: questionnaires_path, method: :post, local: true, id: "questionnaire-form" do |form| %>
          <%= form.hidden_field :questionnaire_id, value: @questionnaire.id %>

          <div class="mb-4">
            <label for="user_name" class="form-label">Ваши инициалы</label>
            <%= form.text_field :user_name, class: "form-control", placeholder: "Введите ваши инициалы", required: true %>
          </div>

          <div class="mb-4">
            <label for="user_last_4_digits" class="form-label">Последние 4 цифры номера телефона</label>
            <%= form.text_field :user_last_4_digits, class: "form-control", placeholder: "Введите последние 4 цифры номера телефона", required: true %>
          </div>

          <% @questionnaire.question_groups.order(:position).each do |question_group| %>
            <div class="card mb-3">
              <div class="card-body">
                <h5 class="card-title"><%= question_group.name %></h5>
                <% question_group.questions.order(:position).each do |question| %>
                  <div class="d-flex flex-wrap gap-3" data-question-id="<%= question.id %>" data-answer-type="<%= question.answer_type %>">
                    <% if question.bool? %>
                      <div class="form-check">
                        <%= form.check_box "answers[#{question.id}]", { class: "form-check-input question-checkbox", id: "question_#{question.id}_checkbox" }, "1", "0" %>
                        <%= form.label "question_#{question.id}_checkbox", question.content, class: "form-check-label" %>
                      </div>
                    <% else %>
                      <p class="card-text"><%= question.content %></p>
                      <% (0..4).each do |score| %>
                        <div class="form-check">
                          <%= form.radio_button "answers[#{question.id}]", score, class: "form-check-input question-radio", id: "question_#{question.id}_score_#{score}", required: true %>
                          <%= form.label "question_#{question.id}_score_#{score}", score, class: "form-check-label" %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="d-grid gap-2">
            <%= form.submit "Отправить", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('questionnaire-form');

    form.addEventListener('submit', function(e) {
      const questionGroups = document.querySelectorAll('[data-question-id]');
      let allAnswered = true;
      let unansweredQuestions = [];

      questionGroups.forEach(function(group, index) {
        const questionId = group.dataset.questionId;
        const answerType = group.dataset.answerType;
        let isAnswered = false;

        if (answerType === 'bool') {
          isAnswered = true;
        } else {
          const radios = group.querySelectorAll('input[type="radio"]');
          isAnswered = Array.from(radios).some(radio => radio.checked);
        }

        if (!isAnswered) {
          allAnswered = false;
          unansweredQuestions.push(index + 1);
        }
      });

      if (!allAnswered) {
        e.preventDefault();
        alert('Пожалуйста, ответьте на все вопросы. Не отвечены вопросы: ' + unansweredQuestions.join(', '));
      }
    });
  });
</script>
